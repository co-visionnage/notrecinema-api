# Copy to .env for `docker compose up`.

# Superuser credentials used once to bootstrap Postgres (creates app_user,
# see ../notrecinema-schema/init.sh) and to apply migrations.
POSTGRES_DB=notrecinema
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Password for the RLS-scoped app_user role this API authenticates as.
APP_DB_PASSWORD=change-me-too

# This service's own connection string, authenticated as app_user.
DATABASE_URL=postgresql://app_user:change-me-too@postgres:5432/notrecinema

# Superuser connection string used only by the one-shot migrate container.
MIGRATE_DATABASE_URL=postgresql://postgres:change-me@postgres:5432/notrecinema

# NATS JetStream -- shared by the API (outbox publisher) and the worker
# (consumer). docker-compose sets this to the nats service's hostname;
# override for local (non-docker) runs.
NATS_URL=nats://nats:4222

PORT=8080
LOG_LEVEL=info
SESSION_COOKIE_NAME=notre_cinema_session
# Origin(s) of the Next.js app allowed to call this API with credentials.
ALLOWED_ORIGINS=http://localhost:3000

# "production" sets Secure on the session cookie and the GitHub OAuth state
# cookie (same process.env.NODE_ENV === 'production' check notrecinema-app
# uses) -- leave as development for local/docker-compose runs over plain HTTP.
APP_ENV=development

# Jaeger (OpenTelemetry OTLP/HTTP collector). docker-compose points this at
# the jaeger service; override for local (non-docker) runs.
OTLP_ENDPOINT=jaeger:4318

# Movie metadata sources for GET /api/v1/movies/{source}/{externalId} --
# each is independently optional. A source with no key just doesn't get
# registered (404 instead of an auth error from the external API).
# TMDB_API_KEY is also reused by internal/calendar (next-episode air dates
# for series imported from OMDb/IMDb-CSV) -- without it, GET .../calendar
# still works but next-episode/check always returns a 400.
# OMDB_API_KEY and KINOPOISK_API_KEY are also reused by internal/seasons
# (new-season tracking) and internal/imports (search) -- note Kinopoisk uses
# a DIFFERENT API for search/seasons (api.kinopoisk.dev/v1.4) than for the
# single-item metadata lookup above (kinopoiskapiunofficial.tech), same key.
TMDB_API_KEY=
OMDB_API_KEY=
KINOPOISK_API_KEY=

# Trakt watchlist import (GET /api/v1/import/trakt) -- a client id is enough
# to read a public watchlist, no per-request user OAuth. Register a free app
# at trakt.tv/oauth/applications.
TRAKT_CLIENT_ID=

# GitHub OAuth login (GET /api/v1/auth/github/start). Register an OAuth App
# at github.com/settings/developers with callback URL
# <this API's own origin>/api/v1/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# S3-compatible object storage (including MinIO) for POST /api/v1/upload/image
# (series poster upload). All five required together; without them the
# endpoint responds with a clear "not configured" error instead of erroring
# on the actual upload attempt. STORAGE_PUBLIC_URL is optional -- defaults to
# "<STORAGE_ENDPOINT>/<STORAGE_BUCKET>" when unset.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# VAPID keypair for web push (used by notrecinema-worker, read from this
# same .env via docker-compose's env_file). Optional: without all three,
# push notifications are silently disabled rather than erroring. It's the
# same VAPID pair notrecinema-app uses (shared across the whole domain, not
# per-service) -- generate once with `npx web-push generate-vapid-keys`
# (notrecinema-app already depends on the web-push package) and reuse it here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Как часто internal/nudges ищет заброшенные сериалы (progress.stale) и
# порог "давности" в днях -- см. README, "Notifications (web push)".
NUDGE_CHECK_INTERVAL=24h
NUDGE_DAYS_THRESHOLD=14

# Почта (читает notrecinema-worker из этого же .env через env_file).
# Опционально: без RESEND_API_KEY письма отключены (подтверждение email,
# сброс пароля, уведомления), остальное работает. Ключ -- в панели Resend
# (API Keys); домен отправителя должен быть подтверждён в Resend.
RESEND_API_KEY=
MAIL_FROM=notrecinema <noreply@notrecinema.ru>
# Необязательно: куда приходят ответы на письма.
MAIL_REPLY_TO=
# Адрес фронтенда без слэша на конце: на него ведут ссылки в письмах
# (/verify-email, /reset-password, /forgot-password, /invite, /unsubscribe,
# /settings). В проде -- https://notrecinema.ru.
APP_URL=http://localhost:3000

# Секрет подписи ссылок «отписаться» в письмах. ОДИН И ТОТ ЖЕ у API (проверяет
# ссылку) и воркера (подписывает её) -- в проде оба читают общий .env.
# Обязателен, когда задан RESEND_API_KEY: воркер без него не стартует.
# Сменить значение можно в любой момент, но все выданные ранее ссылки
# отписки перестанут работать. Сгенерировать: openssl rand -hex 32
UNSUBSCRIBE_SECRET=
